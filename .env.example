# Copy to .env and adjust. All values have sane defaults; nothing here is required.

PORT=3000

# Where the SQLite database and generated session secret live (default ./data).
# In production point this at a persistent disk, e.g. /var/data on Render.
DATA_DIR=

# Set to production when deployed: makes the session cookie HTTPS-only and trusts
# one proxy hop (TRUST_PROXY) so client IPs and HTTPS are detected behind the host's proxy.
NODE_ENV=
TRUST_PROXY=

# Public demo: shows an "Explore with sample data" button on the login page. Each visitor gets a
# private sandbox account with sample transactions (always the built-in assistant), deleted after
# DEMO_TTL_HOURS; at most DEMO_MAX_ACTIVE sandboxes exist at once. Off by default.
DEMO_MODE=false
DEMO_TTL_HOURS=24
DEMO_MAX_ACTIVE=100

# Signs the session cookie. Leave blank and the app generates + persists a strong
# secret at $DATA_DIR/.session-secret on first run. Set your own (>=16 chars) to override.
SESSION_SECRET=

# Currency symbol shown throughout the UI.
CURRENCY=$

# AI assistant backend: rules | ollama | anthropic
#   rules     - deterministic local analysis, no dependencies, always works (default)
#   ollama    - free local model; requires `ollama serve` running
#   anthropic - Claude API; requires ANTHROPIC_API_KEY below
AI_BACKEND=rules

# Only used when AI_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Only used when AI_BACKEND=anthropic (get a key at https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Retrieval (RAG): max transaction rows pulled into context / a search result
RAG_MAX_ROWS=40

# Semantic search — hybrid lexical + embedding retrieval via a local Ollama model.
# Defaults on when AI_BACKEND=ollama; otherwise set EMBED_ENABLED=true.
# Needs: `ollama pull nomic-embed-text`, then build the index on the Rules page.
EMBED_ENABLED=false
EMBED_MODEL=nomic-embed-text
RAG_SEMANTIC_WEIGHT=1
RAG_SEMANTIC_MIN=0.6
# Max transactions embedded per reindex request (the Rules page loops until done)
EMBED_REINDEX_MAX=2000

# Max usable rows accepted in a single CSV import
IMPORT_MAX_ROWS=20000

# LLM assistant tuning
RAG_LLM_ROWS=20            # transaction rows put into the model's context per turn
OLLAMA_NUM_PREDICT=700     # max tokens the local model generates
OLLAMA_KEEP_ALIVE=30m      # how long Ollama keeps the model resident
ANTHROPIC_MAX_TOKENS=4000  # max tokens for the Claude backend
